# Debian 12 with Node.js 22. Playwright installs one browser and its libraries.
FROM node:22-bookworm-slim

# Keep the browser in a folder that the "node" user can read.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app
COPY package.json package-lock.json ./
# "playwright install" downloads the Chromium build for this Playwright version.
# --with-deps adds its Linux libraries and fonts. --only-shell skips the full
# Chromium build, because the service runs headless.
RUN apt-get update \
  && apt-get install -y --no-install-recommends tini \
  && npm ci --omit=dev \
  && npx playwright install --with-deps --only-shell chromium \
  && rm -rf /var/lib/apt/lists/* /root/.npm
COPY server.js healthcheck.js ./

USER node
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s CMD ["node", "healthcheck.js"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
