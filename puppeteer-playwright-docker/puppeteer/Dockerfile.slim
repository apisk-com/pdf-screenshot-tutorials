# Debian 12 with Node.js 22. Puppeteer downloads Chrome for Testing, and
# --install-deps adds the libraries that Chrome needs.
FROM node:22-bookworm-slim

WORKDIR /app
# Keep Chrome in a folder that the "node" user can read.
ENV PUPPETEER_CACHE_DIR=/app/.cache/puppeteer
# The service uses Chrome in headless mode, so skip the second browser build.
ENV PUPPETEER_CHROME_HEADLESS_SHELL_SKIP_DOWNLOAD=true

COPY package.json package-lock.json ./
RUN apt-get update \
  && apt-get install -y --no-install-recommends unzip tini \
    fonts-liberation fonts-noto-cjk fonts-noto-color-emoji \
  && npm ci --omit=dev \
  && npx puppeteer browsers install chrome --install-deps \
  && rm -rf /var/lib/apt/lists/* /root/.npm
COPY server.js healthcheck.js ./

USER node
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s CMD ["node", "healthcheck.js"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server.js"]
